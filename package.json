{
  "name": "reactcanvas-studio",
  "private": true,
  "version": "1.0.0",
  "description": "A plug-and-play, plugin-based React component library for building Canva-like design editors",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "demo": "pnpm --filter @reactcanvas/demo dev"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": []
  }
}
