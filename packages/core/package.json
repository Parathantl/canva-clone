{
  "name": "@reactcanvas/core",
  "version": "1.0.0",
  "description": "Core document model, types, state management, event bus, and plugin API for ReactCanvas Studio",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "zustand": "^5.0.0",
    "immer": "^10.1.0",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "keywords": ["dashboard", "canvas", "editor", "react", "chart", "visualization", "quicksight", "data"],
  "repository": {
    "type": "git",
    "url": "https://github.com/reactcanvas/studio",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/reactcanvas/studio#readme",
  "sideEffects": false,
  "license": "MIT"
}
