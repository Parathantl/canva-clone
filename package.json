{
  "name": "reactcanvas-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Open-source dashboard builder and slide editor for React — like QuickSight/Tableau, but embeddable",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "demo": "pnpm --filter @reactcanvas/demo dev",
    "publish:all": "pnpm build && pnpm -r --filter './packages/*' publish --access public --no-git-checks"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": []
  }
}
