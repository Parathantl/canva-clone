{
  "name": "@reactcanvas/editor",
  "version": "1.0.0",
  "description": "Main editor component for ReactCanvas Studio - Canva-like design editor for React",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@reactcanvas/core": "workspace:*",
    "@reactcanvas/export": "workspace:*",
    "@reactcanvas/history": "workspace:*",
    "@reactcanvas/images": "workspace:*",
    "@reactcanvas/pages": "workspace:*",
    "@reactcanvas/plugins": "workspace:*",
    "@reactcanvas/react": "workspace:*",
    "@reactcanvas/shapes": "workspace:*",
    "@reactcanvas/text": "workspace:*",
    "dompurify": "^3.3.2",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "license": "MIT"
}
