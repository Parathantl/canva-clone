{
  "name": "@reactcanvas/editor",
  "version": "1.0.0",
  "description": "Customizable dashboard builder & slide editor for React — like QuickSight/Tableau, but open-source and embeddable",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.mjs",
      "require": "./dist/viewer.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@reactcanvas/core": "workspace:*",
    "@reactcanvas/export": "workspace:*",
    "@reactcanvas/history": "workspace:*",
    "@reactcanvas/images": "workspace:*",
    "@reactcanvas/pages": "workspace:*",
    "@reactcanvas/plugins": "workspace:*",
    "@reactcanvas/react": "workspace:*",
    "@reactcanvas/shapes": "workspace:*",
    "@reactcanvas/text": "workspace:*",
    "chart.js": "^4.5.1",
    "dompurify": "^3.3.2",
    "html2canvas": "^1.4.1",
    "react-chartjs-2": "^5.3.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": ["dashboard", "canvas", "editor", "react", "chart", "visualization", "quicksight", "data"],
  "repository": {
    "type": "git",
    "url": "https://github.com/reactcanvas/studio",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/reactcanvas/studio#readme",
  "sideEffects": false,
  "license": "MIT"
}
